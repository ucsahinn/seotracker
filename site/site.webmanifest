{
  "name": "seowatcher",
  "short_name": "seowatcher",
  "description": "Search Console, Analytics 4 ve site denetimi tek bir ücretsiz, açık kaynak uygulamada.",
  "lang": "tr",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "theme_color": "#0c0b0a",
  "background_color": "#0c0b0a",
  "icons": [
    { "src": "/assets/favicon-48.png", "sizes": "48x48", "type": "image/png" },
    {
      "src": "/assets/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    { "src": "/assets/icon-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "/assets/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
